# ---------------------------------------------------------------------------
# Swap'n'Serve — environment variables
# Copy to `.env` (or `.env.local`) and fill in. Never commit real values.
# In Lovable, set these under Project → Settings → Environment variables.
# ---------------------------------------------------------------------------

# Supabase (frontend). The anon key is public-safe — access is guarded by RLS.
# Find both under Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# The values below are NOT used by the frontend. They are Supabase Edge
# Function secrets — set them with `supabase secrets set KEY=value`, never in
# the browser bundle. Listed here only as documentation.
# ---------------------------------------------------------------------------

# Stripe (test mode). Secret key + webhook signing secret.
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase service role key — lets edge functions bypass RLS. KEEP SECRET.
#   SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin passcode for /cup/admin. Use a long random string.
#   ADMIN_TOKEN=change-me-to-a-long-random-secret

# Public site origin, used to build Stripe success/cancel redirect URLs.
#   SITE_URL=https://your-live-site.example
